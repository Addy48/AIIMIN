<?xml version="1.0" encoding="utf-8"?>
<!--
  Official AIIMIN Brand Mark for status bar notification icon.
  Monochromatic white silhouette with alpha transparency.
  Arch, peak-A chevron, and summit spark node.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.82"
        android:scaleY="0.82"
        android:translateY="4">

        <!-- Outer Arch -->
        <path
            android:pathData="M80,384 C80,192 208,112 256,112 C304,112 432,192 432,384"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="32"
            android:strokeAlpha="0.75"
            android:strokeLineCap="round" />

        <!-- Peak A Chevron -->
        <path
            android:pathData="M144,384 L256,176 L368,384"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="32"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Inner Chevron -->
        <path
            android:pathData="M192,368 L256,272 L320,368"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="24"
            android:strokeAlpha="0.85"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- Summit Spark Node -->
        <path
            android:pathData="M256,206 A34,34 0 1,1 256,274 A34,34 0 1,1 256,206 Z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
